{
  "name": "hicode",
  "version": "0.1.0",
  "private": true,
  "description": "Painel do hicode (Nuxt 4 + Vue 3) e o estado em disco (cards/, config/). O motor de execucao vive no repo hii.",
  "type": "module",
  "scripts": {
    "panel": "cd panel && bun run dev",
    "panel:build": "cd panel && bun run build",
    "typecheck": "tsc --noEmit",
    "typecheck:panel": "cd panel && bun run typecheck",
    "lint:types": "bun scripts/check-no-any.mjs",
    "test:unit": "bun scripts/test-unit-isolado.mjs",
    "test": "bun run typecheck && bun run lint:types && bun run test:unit && bun run typecheck:panel",
    "test:e2e:status": "bun run panel:build && node scripts/test-motor-status.mjs",
    "test:e2e:recuperacao": "node scripts/test-recuperacao.mjs"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.0",
    "playwright": "^1.61.1",
    "typescript": "^5.7.2"
  }
}
